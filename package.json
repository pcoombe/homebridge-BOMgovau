{
  "name": "homebridge-bomgovau-v2",
  "displayName": "Homebridge BOM Weather",
  "version": "0.3.0",
  "description": "Makes BOM.gov.au data available in your Homebridge(Homekit) setup",
  "homepage": "https://github.com/pcoombe/homebridge-BOMgovau",
  "license": "Apache-2",
  "keywords": [
    "homebridge-plugin",
    "BOM",
    "Bureau of Meteorology",
    "BOM.gov.au",
    "BOMgovau",
    "Australia",
    "weather",
    "sensor",
    "temperature",
    "humidity",
    "pressure"
  ],
  "author": {
    "name": "Stephen Cohen, Peter Coombe"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/pcoombe/homebridge-BOMgovau"
  },
  "bugs": {
    "url": "https://github.com/pcoombe/homebridge-BOMgovau/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "homebridge": ">=2.0.0"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Accessory Name",
        "type": "string",
        "default": "BOM Weather Station",
        "description": "Display name shown in HomeKit"
      },
      "stationURL": {
        "title": "BOM Station URL",
        "type": "string",
        "default": "http://reg.bom.gov.au/fwo/IDN60903/IDN60903.94926.json",
        "description": "JSON observation feed URL from BOM.gov.au. Find your station's JSON feed at bom.gov.au/australia/observations/"
      },
      "updateFrequency": {
        "title": "Update Interval (milliseconds)",
        "type": "integer",
        "minimum": 60000,
        "default": 1800000,
        "description": "How often to fetch new observations from BOM. Minimum 60000 (1 minute). Default 1800000 (30 minutes)."
      },
      "sensors": {
        "title": "Enabled Sensors",
        "type": "object",
        "properties": {
          "temperature": {
            "title": "Temperature",
            "type": "boolean",
            "default": true,
            "description": "Enable the temperature sensor"
          },
          "humidity": {
            "title": "Humidity",
            "type": "boolean",
            "default": true,
            "description": "Enable the humidity sensor"
          },
          "apparentTemp": {
            "title": "Apparent Temperature ('Feels Like')",
            "type": "boolean",
            "default": true,
            "description": "Enable the apparent temperature sensor"
          },
          "pressure": {
            "title": "Air Pressure (hPa)",
            "type": "boolean",
            "default": true,
            "description": "Enable the separate Eve-compatible air pressure service"
          }
        },
        "default": {
          "temperature": true,
          "humidity": true,
          "apparentTemp": true,
          "pressure": true
        },
        "description": "Enable or disable individual weather sensors"
      }
    }
  },
  "main": "index.js",
  "scripts": {
    "lint": "eslint index.js lib/bom-client.js scripts/test-bom-feed.js",
    "parse": "node --check index.js && node --check lib/bom-client.js && node --check scripts/test-bom-feed.js",
    "test:bom-feed": "node scripts/test-bom-feed.js"
  },
  "dependencies": {
    "fakegato-history": "^0.6.2"
  },
  "devDependencies": {
    "eslint": "^10.15.0"
  }
}
